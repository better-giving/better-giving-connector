{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"typeRoots": ["./node_modules/@types"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src",
		"test",
		"migrations",
		"scripts",
		"vitest.config.ts",
		"vitest.live.config.ts",
		".cursor/skills/verify-better-giving-connector/scripts"
	]
}
