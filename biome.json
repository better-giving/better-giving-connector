{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!pnpm-lock.yaml",
			"!lint/*.grit",
			"!**/*.mp4",
			"!.claude",
			"!.mcp.json"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noFloatingPromises": "error"
			},
			"suspicious": {
				"noTsIgnore": "error",
				"noFocusedTests": "error",
				"noConsole": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"better-auth": "Import better-auth only inside src/auth/.",
							"@libsql/client": "Import @libsql/client only inside src/db/.",
							"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/.",
							"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/."
						},
						"patterns": [
							{
								"group": ["better-auth/**"],
								"message": "Import better-auth only inside src/auth/."
							},
							{
								"group": ["@modelcontextprotocol/**"],
								"message": "Import @modelcontextprotocol/server only inside src/mcp/ and @modelcontextprotocol/ext-apps only inside src/widgets/."
							},
							{
								"group": ["@libsql/client/**"],
								"message": "Import @libsql/client only inside src/db/."
							},
							{
								"group": ["@better-auth/**"],
								"message": "Import better-auth only inside src/auth/."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"plugins": ["./lint/no-coerce-boolean.grit"],
	"overrides": [
		{
			"includes": ["src/**", "!**/*.test.*"],
			"plugins": ["./lint/no-stage-branching.grit"]
		},
		{
			"includes": ["src/log.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["src/auth/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@libsql/client": "Import @libsql/client only inside src/db/.",
									"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/.",
									"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/."
								},
								"patterns": [
									{
										"group": ["@modelcontextprotocol/**"],
										"message": "Import @modelcontextprotocol/server only inside src/mcp/ and @modelcontextprotocol/ext-apps only inside src/widgets/."
									},
									{
										"group": ["@libsql/client/**"],
										"message": "Import @libsql/client only inside src/db/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/db/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"better-auth": "Import better-auth only inside src/auth/.",
									"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/.",
									"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/."
								},
								"patterns": [
									{
										"group": ["better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@modelcontextprotocol/**"],
										"message": "Import @modelcontextprotocol/server only inside src/mcp/ and @modelcontextprotocol/ext-apps only inside src/widgets/."
									},
									{
										"group": ["@better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/mcp/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"better-auth": "Import better-auth only inside src/auth/.",
									"@libsql/client": "Import @libsql/client only inside src/db/.",
									"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/."
								},
								"patterns": [
									{
										"group": ["better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@libsql/client/**"],
										"message": "Import @libsql/client only inside src/db/."
									},
									{
										"group": ["@better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@modelcontextprotocol/ext-apps/**"],
										"message": "Import @modelcontextprotocol/ext-apps only inside src/widgets/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/deployment/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"better-auth": "Import better-auth only inside src/auth/.",
									"@libsql/client": "Import @libsql/client only inside src/db/.",
									"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/.",
									"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/."
								},
								"patterns": [
									{
										"group": ["better-auth/**", "@better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@modelcontextprotocol/**"],
										"message": "Import @modelcontextprotocol/server only inside src/mcp/ and @modelcontextprotocol/ext-apps only inside src/widgets/."
									},
									{
										"group": ["@libsql/client/**"],
										"message": "Import @libsql/client only inside src/db/."
									},
									{
										"group": [
											"../**/db",
											"../**/db/**",
											"../**/auth",
											"../**/auth/**",
											"../**/mcp",
											"../**/mcp/**"
										],
										"message": "src/deployment/ imports nothing from src/db/, src/auth/ or src/mcp/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/widgets/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"better-auth": "Import better-auth only inside src/auth/.",
									"@libsql/client": "Import @libsql/client only inside src/db/.",
									"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/."
								},
								"patterns": [
									{
										"group": ["better-auth/**", "@better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@libsql/client/**"],
										"message": "Import @libsql/client only inside src/db/."
									},
									{
										"group": ["@modelcontextprotocol/server/**"],
										"message": "Import @modelcontextprotocol/server only inside src/mcp/."
									},
									{
										"group": [
											"../**/db",
											"../**/db/**",
											"../**/auth",
											"../**/auth/**",
											"../**/mcp",
											"../**/mcp/**",
											"../**/deployment",
											"../**/deployment/**",
											"../**/connect",
											"../**/connect/**",
											"../**/site",
											"../**/site/**",
											"../**/env",
											"../**/env/**",
											"../**/env.*",
											"../**/log",
											"../**/log/**",
											"../**/log.*",
											"../**/secret",
											"../**/secret/**",
											"../**/secret.*"
										],
										"message": "src/widgets/ is browser code: it imports nothing from src/db/, src/auth/, src/mcp/, src/deployment/, src/connect/, src/site/, src/env.ts, src/log.ts or src/secret.ts."
									},
									{
										"group": ["node:*"],
										"message": "src/widgets/ is browser code: no node:* imports."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/format.ts", "src/presets/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"better-auth": "Import better-auth only inside src/auth/.",
									"@libsql/client": "Import @libsql/client only inside src/db/.",
									"@modelcontextprotocol/server": "Import @modelcontextprotocol/server only inside src/mcp/.",
									"@modelcontextprotocol/ext-apps": "Import @modelcontextprotocol/ext-apps only inside src/widgets/."
								},
								"patterns": [
									{
										"group": ["better-auth/**", "@better-auth/**"],
										"message": "Import better-auth only inside src/auth/."
									},
									{
										"group": ["@modelcontextprotocol/**"],
										"message": "Import @modelcontextprotocol/server only inside src/mcp/ and @modelcontextprotocol/ext-apps only inside src/widgets/."
									},
									{
										"group": ["@libsql/client/**"],
										"message": "Import @libsql/client only inside src/db/."
									},
									{
										"group": ["node:*"],
										"message": "src/format.ts and src/presets/ are shared with the widgets: no node:* imports."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.test.*", "test/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
