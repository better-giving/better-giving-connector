{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "hono",
	"buildCommand": "pnpm run db:migrate && pnpm run build",
	"outputDirectory": "dist",
	"fluid": true,
	"regions": ["iad1"],
	"crons": [{ "path": "/cron/sweep", "schedule": "17 3 * * *" }],
	"ignoreCommand": "bash scripts/vercel-ignore-build.sh"
}
