{
	"name": "better-giving-connector",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "tsx watch --import ./scripts/binary-register.mjs --env-file-if-exists=.env.local src/dev.ts",
		"build": "tsx scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "sh -c '[ $# -gt 0 ] || { echo \"format: pass the paths to format; pnpm lint checks the whole tree\" >&2; exit 1; }; biome format --write \"$@\"' --",
		"test": "vitest run",
		"test:live": "vitest run --config vitest.live.config.ts",
		"db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-cli.ts",
		"chatgpt:package": "tsx scripts/chatgpt-package.ts"
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.7",
		"@better-auth/mcp": "1.7.7",
		"@better-auth/oauth-provider": "1.7.7",
		"@hono/node-server": "2.1.4",
		"@libsql/client": "0.18.0",
		"@modelcontextprotocol/server": "2.2.0",
		"better-auth": "1.7.7",
		"hono": "4.13.13",
		"kysely": "0.29.6",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
